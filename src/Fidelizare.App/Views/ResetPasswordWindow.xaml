<Window x:Class="Fidelizare.App.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resetarea parolei"
        Width="430" MinHeight="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Resetarea parolei" Style="{StaticResource H2}" />
            <TextBlock x:Name="ContextText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
        <StackPanel>
            <TextBlock Text="PAROLĂ NOUĂ" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PasswordBox" />

            <TextBlock Text="CONFIRMĂ PAROLA" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <PasswordBox x:Name="ConfirmBox" />

            <Border Style="{StaticResource Banner}" Margin="0,14,0,0">
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="Utilizatorul va fi obligat să își aleagă o parolă proprie la următoarea autentificare, astfel încât parola stabilită aici să nu rămână cunoscută altcuiva." />
            </Border>

            <Border x:Name="ErrorBanner" Background="{StaticResource DangerSoft}"
                    CornerRadius="6" Padding="10,7" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Renunță" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                    IsCancel="True" Click="OnCancel" />
            <Button Content="Resetează" IsDefault="True" Click="OnReset" MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
