<Window x:Class="Fidelizare.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmare"
        Width="450" MinHeight="260"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeadingText" Style="{StaticResource H2}" />
            <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock x:Name="FieldLabelText" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ValueBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />

            <Border x:Name="ErrorBanner" Background="{StaticResource DangerSoft}"
                    CornerRadius="6" Padding="10,7" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Renunță" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                    IsCancel="True" Click="OnCancel" />
            <Button x:Name="ConfirmButton" Content="Confirmă" IsDefault="True" Click="OnConfirm" MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
