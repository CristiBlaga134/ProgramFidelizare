<Window x:Class="Fidelizare.App.Views.AdjustPointsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corecție de puncte"
        Width="450" MinHeight="340"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Corecție de puncte" Style="{StaticResource H2}" />
            <TextBlock x:Name="ContextText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
        <StackPanel>

            <TextBlock Text="OPERAȚIUNE" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AddRadio" Content="Adaugă puncte" IsChecked="True" Margin="0,0,20,0" />
                <RadioButton x:Name="RemoveRadio" Content="Scade puncte" />
            </StackPanel>

            <TextBlock Text="NUMĂR DE PUNCTE" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
            <TextBox x:Name="PointsBox" Style="{StaticResource AmountBox}" TextAlignment="Left" />

            <TextBlock Text="MOTIVUL CORECȚIEI" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
            <TextBox x:Name="ReasonBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Motivul rămâne în istoricul clientului și în jurnalul de operațiuni." />

            <Border x:Name="ErrorBanner" Background="{StaticResource DangerSoft}"
                    CornerRadius="6" Padding="10,7" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Renunță" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                    IsCancel="True" Click="OnCancel" />
            <Button Content="Aplică corecția" IsDefault="True" Click="OnApply" MinWidth="140" />
        </StackPanel>
    </Grid>
</Window>
