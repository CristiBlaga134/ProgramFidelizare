<Window x:Class="Fidelizare.App.Views.CustomFieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Câmp pe fișa clientului"
        Width="500" MinHeight="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Informația în plus pe care magazinul vrea să o rețină despre fiecare client." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <StackPanel>

                <TextBlock Text="ETICHETA AFIȘATĂ *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="LabelBox" TextChanged="OnLabelChanged" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="Textul care apare lângă câmp în fișa clientului. Ex: Mărime preferată." />

                <TextBlock Text="NUME SCURT *" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                <TextBox x:Name="KeyBox" PreviewKeyDown="OnKeyTyped" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Folosit ca antet de coloană la import și export. Se completează singur, dar poate fi schimbat. Doar litere, cifre și liniuță de subliniere." />

                <TextBlock Text="TIPUL CÂMPULUI" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                <ComboBox x:Name="KindBox" SelectionChanged="OnKindChanged">
                    <ComboBoxItem Content="Text" IsSelected="True" />
                    <ComboBoxItem Content="Număr" />
                    <ComboBoxItem Content="Dată" />
                    <ComboBoxItem Content="Da / Nu" />
                    <ComboBoxItem Content="Listă de opțiuni" />
                </ComboBox>

                <StackPanel x:Name="OptionsPanel" Visibility="Collapsed">
                    <TextBlock Text="OPȚIUNI, CÂTE UNA PE LINIE *" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                    <TextBox x:Name="OptionsBox" Height="88" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Casierul va putea alege doar dintre acestea." />
                </StackPanel>

                <Border Style="{StaticResource Banner}" Margin="0,18,0,0">
                    <StackPanel>
                        <CheckBox x:Name="RequiredCheck" Content="Completarea este obligatorie" />
                        <CheckBox x:Name="SearchCheck" Content="Se poate căuta după această valoare"
                                  IsChecked="True" Margin="0,8,0,0" />
                        <CheckBox x:Name="ListCheck" Content="Apare ca o coloană în lista de clienți"
                                  Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="ActiveCheck" Content="Câmp activ" IsChecked="True" Margin="0,16,0,0" />
                <TextBlock Style="{StaticResource Caption}" Margin="24,4,0,0" TextWrapping="Wrap"
                           Text="Un câmp dezactivat dispare din formular, dar valorile deja completate rămân în baza de date." />

                <Border x:Name="ErrorBanner" Background="{StaticResource DangerSoft}"
                        CornerRadius="6" Padding="10,7" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Renunță" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                    IsCancel="True" Click="OnCancel" />
            <Button Content="Salvează" IsDefault="True" Click="OnSave" MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
