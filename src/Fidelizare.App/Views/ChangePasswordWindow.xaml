<Window x:Class="Fidelizare.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schimbarea parolei"
        Width="400" MinHeight="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Schimbarea parolei" Style="{StaticResource H2}" />
            <TextBlock x:Name="HintText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
        <StackPanel>
            <TextBlock Text="PAROLA ACTUALĂ" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="CurrentBox" />

            <TextBlock Text="PAROLA NOUĂ" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
            <PasswordBox x:Name="NewBox" />

            <TextBlock Text="CONFIRMĂ PAROLA NOUĂ" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
            <PasswordBox x:Name="ConfirmBox" />

            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Minimum 8 caractere, cu cel puțin o literă și o cifră." />

            <Border x:Name="ErrorBanner" Background="{StaticResource DangerSoft}"
                    CornerRadius="6" Padding="12,9" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Renunță" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0" IsCancel="True" Click="OnCancel" />
            <Button Content="Salvează" IsDefault="True" Click="OnSave" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
