<Window x:Class="Fidelizare.App.Views.ReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retur produse"
        Width="500" MinHeight="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Retur produse" Style="{StaticResource H2}" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Se retrag punctele aferente sumei returnate, iar suma iese din rulajul pe care se calculează nivelul." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
        <StackPanel>

            <!-- Căutarea bonului, când returul pornește de la casă -->
            <StackPanel x:Name="ReceiptPanel">
                <TextBlock Text="NUMĂRUL BONULUI" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ReceiptBox" Grid.Column="0" KeyDown="OnReceiptKeyDown" />
                    <Button Grid.Column="1" Content="Caută bonul" Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0" Click="OnFindReceipt" />
                </Grid>
            </StackPanel>

            <!-- Bonul găsit -->
            <Border x:Name="PurchaseCard" Style="{StaticResource CardTight}" Margin="0,14,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="CustomerText" Style="{StaticResource H3}" />
                    <TextBlock x:Name="PurchaseText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock x:Name="ReturnedText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="ReturnPanel" Visibility="Collapsed">
                <TextBlock Text="VALOAREA PRODUSELOR RETURNATE (LEI)" Style="{StaticResource FieldLabel}"
                           Margin="0,16,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="AmountBox" Grid.Column="0" Style="{StaticResource AmountBox}"
                             TextAlignment="Left" TextChanged="OnAmountChanged" />
                    <Button Grid.Column="1" Content="Tot bonul" Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0" Click="OnReturnAll" />
                </Grid>
                <TextBlock x:Name="PreviewText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />

                <TextBlock Text="MOTIVUL RETURULUI" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                <TextBox x:Name="ReasonBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="De exemplu: ce produse s-au returnat și numărul documentului de retur de la casa de marcat." />
            </StackPanel>

            <Border x:Name="ErrorBanner" Background="{StaticResource DangerSoft}"
                    CornerRadius="6" Padding="10,7" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Renunță" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                    IsCancel="True" Click="OnCancel" />
            <Button x:Name="ApplyButton" Content="Înregistrează returul" Click="OnApply" MinWidth="170"
                    IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
