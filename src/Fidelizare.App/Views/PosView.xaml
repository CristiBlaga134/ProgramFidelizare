<UserControl x:Class="Fidelizare.App.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fidelizare.App.ViewModels"
             xmlns:model="clr-namespace:Fidelizare.Core.Model;assembly=Fidelizare.Core"
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================== Căutare ==== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Casă" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Scanează cardul, tastează telefonul sau caută clientul după nume." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Retur" Style="{StaticResource SecondaryButton}"
                        Click="OnReturn" Margin="0,0,8,0" />
                <Button Content="Client nou" Style="{StaticResource SecondaryButton}"
                        Click="OnNewCustomer" Margin="0,0,8,0" />
                <Button Content="Golește ecranul" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchInput" Grid.Column="0"
                     Style="{StaticResource SearchBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSearchKeyDown" />

            <Button Grid.Column="1" Content="Caută" Margin="10,0,0,0" MinWidth="110"
                    Style="{StaticResource BigButton}" Command="{Binding SearchCommand}" />
        </Grid>

        <!-- ================================================= Conținut ==== -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource WarningSoft}"
                    CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
                    Visibility="{Binding ShowSingleAccountHint, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Warning}"
                                   Text="Lucrezi cu contul de administrator" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource Warning}"
                                   Text="Programul reține cine a făcut fiecare operațiune, dar deocamdată există un singur cont. Fără conturi separate, jurnalul va arăta „Administrator” peste tot." />
                    </StackPanel>

                    <Button Grid.Column="1" Content="Creează conturi" Margin="12,0,0,0"
                            VerticalAlignment="Center" Click="OnOpenStaffAccounts" />
                </Grid>
            </Border>

            <!-- ========================================== Coloana stângă ==== -->
            <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
                <StackPanel>

                    <!-- Nicio căutare încă -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding HasCustomer, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Niciun client selectat" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Caută clientul înainte de a înregistra vânzarea. Dacă nu este încă înscris în program, apasă „Client nou” — înscrierea durează câteva secunde și clientul primește imediat bonusul de bun venit." />

                            <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" TextWrapping="Wrap"
                                       Text="Poți căuta după codul de pe card, după numărul de telefon sau după nume. Diacriticele nu contează." />
                        </StackPanel>
                    </Border>

                    <!-- Fără rezultate -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                            Background="{StaticResource WarningSoft}"
                            BorderBrush="{StaticResource Warning}"
                            Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Niciun client găsit" Style="{StaticResource H3}"
                                       Foreground="{StaticResource Warning}" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Verifică textul căutat sau înscrie clientul în program apăsând „Client nou”." />
                        </StackPanel>
                    </Border>

                    <!-- Mai multe potriviri -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                            Visibility="{Binding ShowResultList, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Mai mulți clienți se potrivesc" Style="{StaticResource H3}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,10"
                                       Text="Alege clientul corect din listă." />

                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:Customer}">
                                        <Button Style="{StaticResource SecondaryButton}"
                                                HorizontalContentAlignment="Stretch"
                                                Margin="0,0,0,6" Padding="12,9"
                                                Command="{Binding DataContext.SelectCustomerCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding FullName}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Caption}"
                                                           Text="{Binding CardCode, StringFormat='Card {0}'}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ================================== Fișa clientului -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding CustomerName}" Style="{StaticResource H1}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                               Text="{Binding CardLabel}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="{Binding ContactLabel}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <Border CornerRadius="20" Padding="14,5" HorizontalAlignment="Right"
                                            Background="{Binding TierColor, Converter={StaticResource HexToBrush}}">
                                        <TextBlock Text="{Binding TierName}" Foreground="White"
                                                   FontWeight="SemiBold" FontSize="12.5" />
                                    </Border>
                                    <Button Content="Vezi fișa completă" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right" Margin="0,6,0,0"
                                            Click="OnOpenCustomer" />
                                </StackPanel>
                            </Grid>

                            <Separator />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" MinWidth="150">
                                    <TextBlock Text="PUNCTE DISPONIBILE" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding PointsBalance}" Style="{StaticResource Metric}"
                                               Foreground="{DynamicResource Accent}" />
                                    <TextBlock Text="{Binding PointsValueLabel}" Style="{StaticResource Caption}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <ProgressBar Height="8" Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                 Background="{StaticResource Bg}"
                                                 Foreground="{DynamicResource Accent}"
                                                 BorderThickness="0" />
                                    <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource Caption}"
                                               Margin="0,7,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding TierBenefits}" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextFaint}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0">
                                <Run Text="{Binding LastPurchaseLabel, Mode=OneWay}" />
                                <Run Text="  ·  " />
                                <Run Text="{Binding LifetimeLabel, Mode=OneWay}" />
                            </TextBlock>

                            <!-- Avertisment de expirare -->
                            <Border Background="{StaticResource WarningSoft}" CornerRadius="6"
                                    Padding="12,9" Margin="0,12,0,0"
                                    Visibility="{Binding HasExpiryWarning, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ExpiryWarning}" Foreground="{StaticResource Warning}"
                                           TextWrapping="Wrap" FontWeight="SemiBold" />
                            </Border>

                            <!-- Zi de naștere -->
                            <Border Background="{StaticResource SuccessSoft}" CornerRadius="6"
                                    Padding="12,9" Margin="0,10,0,0"
                                    Visibility="{Binding BirthdayBonusAvailable, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{StaticResource Success}" FontWeight="SemiBold"
                                               Text="Clientul își serbează zilele. Bonusul aniversar poate fi acordat." />
                                    <Button Grid.Column="1" Content="Acordă bonusul" Margin="10,0,0,0"
                                            Command="{Binding BirthdayBonusCommand}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ================================= Înregistrare bon -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Înregistrează vânzarea" Style="{StaticResource H2}" />

                            <Border Background="{StaticResource SuccessSoft}" CornerRadius="6"
                                    Padding="12,9" Margin="0,10,0,0"
                                    Visibility="{Binding HasCampaign, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding CampaignLabel}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" Foreground="{StaticResource Success}" />
                            </Border>

                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="6"
                                    Padding="12,9" Margin="0,10,0,0"
                                    Visibility="{Binding HasPointsDiscount, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding PointsDiscountLabel}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                            </Border>

                            <Border Background="{StaticResource WarningSoft}" CornerRadius="6"
                                    Padding="12,8" Margin="0,10,0,0"
                                    Visibility="{Binding CanUndoRedemption, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Style="{StaticResource Caption}" Foreground="{StaticResource Warning}"
                                               Text="Ai acordat greșit recompensa? O poți anula acum, fără responsabil." />

                                    <Button Grid.Column="1" Margin="10,0,0,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="{Binding UndoRedemptionLabel}"
                                            Command="{Binding UndoRedemptionCommand}" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="VALOARE BON (LEI)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="GrossInput" Style="{StaticResource AmountBox}"
                                             Text="{Binding GrossAmount, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="OnAmountKeyDown" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="REDUCERE (LEI)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource AmountBox}"
                                             Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="OnAmountKeyDown" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="NUMĂR BON (OPȚIONAL)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource AmountBox}" TextAlignment="Left"
                                             Text="{Binding ReceiptNumber, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="OnAmountKeyDown" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="DE ÎNCASAT" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding NetPreview}" Style="{StaticResource H2}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="PUNCTE ACORDATE" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding PointsPreview}" Style="{StaticResource H3}"
                                               Foreground="{StaticResource Success}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Column="2" Content="Înregistrează vânzarea"
                                        Style="{StaticResource BigButton}" MinWidth="210"
                                        Command="{Binding RecordSaleCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ========================================== Rezultat -->
                    <Border CornerRadius="8" Padding="14,12" Margin="0,14,0,0"
                            Visibility="{Binding StatusMessage, Converter={StaticResource TextToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                        <Setter Property="Background" Value="{StaticResource WarningSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                        <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                            <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========================================= Coloana dreaptă ==== -->
            <Grid Grid.Row="1" Grid.Column="1"
                  Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardTight}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="6,4,6,10">
                            <TextBlock Text="Recompense" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="Completează valoarea bonului ca să se activeze recompensele cu prag minim." />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rewards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RewardOption}">
                                        <Border Background="{StaticResource SurfaceAlt}"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueLabel}"
                                                               Foreground="{DynamicResource Accent}"
                                                               FontWeight="SemiBold" Margin="8,0,0,0" />
                                                </Grid>

                                                <TextBlock Text="{Binding PointsLabel}"
                                                           Style="{StaticResource Caption}" Margin="0,3,0,0" />

                                                <TextBlock Text="{Binding Blocker}" TextWrapping="Wrap"
                                                           Style="{StaticResource Caption}"
                                                           Foreground="{StaticResource Warning}" Margin="0,6,0,0"
                                                           Visibility="{Binding Blocker,
                                                                        Converter={StaticResource TextToVisibility}}" />

                                                <Button Content="Acordă recompensa" Margin="0,10,0,0"
                                                        HorizontalAlignment="Stretch"
                                                        IsEnabled="{Binding CanRedeem}"
                                                        Command="{Binding DataContext.RedeemCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,12,0,0" MaxHeight="260">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Mișcări recente" Style="{StaticResource H3}"
                                   Margin="6,4,6,8" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:PointTransaction}">
                                        <Grid Margin="6,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="12.5" />
                                                <TextBlock Text="{Binding OccurredAt, StringFormat='dd.MM.yyyy HH:mm'}"
                                                           Style="{StaticResource Caption}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Points, Converter={StaticResource SignedPoints}}"
                                                       Foreground="{Binding Points, Converter={StaticResource PointsBrush}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
