<UserControl x:Class="Fidelizare.App.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Administrare" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Regulile programului, nivelurile, catalogul de recompense și conturile personalului." />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,14,0,0">

            <!-- =========================================== Reguli ==== -->
            <TabItem Header="Reguli">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Acumularea punctelor" Style="{StaticResource H2}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="LEI CHELTUIȚI PENTRU UN PUNCT" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="LeiPerPointBox" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="Cu 10, un bon de 250 lei aduce 25 de puncte." />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="VALOAREA MINIMĂ A BONULUI" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MinPurchaseBox" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="Sub această sumă nu se acordă puncte. Zero înseamnă fără prag." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Folosirea punctelor" Style="{StaticResource H2}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="VALOAREA UNUI PUNCT (LEI)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="PointValueBox" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="Folosită pentru estimările afișate și pentru calculul sumei datorate clienților." />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PRAG MINIM DE REVENDICARE" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MinRedeemBox" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="Sub acest sold nu se poate revendica nicio recompensă." />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,14,0,0" MaxWidth="400" HorizontalAlignment="Left">
                                    <TextBlock Text="CASIERUL ÎȘI POATE ANULA RECOMPENSA (MINUTE)"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="SelfVoidBox" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Cât timp după acordare casierul își poate corecta singur greșeala, fără să cheme responsabilul. Zero înseamnă că orice anulare trece prin responsabil." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Expirarea punctelor" Style="{StaticResource H2}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="VALABILITATE (LUNI)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ValidityBox" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="Zero oprește expirarea. Punctele deja acordate își păstrează termenul stabilit la acordare." />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="AVERTIZARE ÎNAINTE DE EXPIRARE (ZILE)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="WarningDaysBox" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="Cu cât timp înainte apare avertismentul la casă." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Bonusuri și niveluri" Style="{StaticResource H2}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="BONUS LA ÎNSCRIERE" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="WelcomeBox" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="BONUS DE ZI DE NAȘTERE" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="BirthdayBox" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="FEREASTRĂ ANIVERSARĂ (ZILE)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="BirthdayWindowBox" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="NIVELUL SE CALCULEAZĂ DUPĂ" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="TierBasisBox" SelectionChanged="OnTierBasisChanged">
                                            <ComboBoxItem Content="Rulajul în lei" IsSelected="True" />
                                            <ComboBoxItem Content="Punctele acumulate" />
                                            <ComboBoxItem Content="Numărul de cumpărături" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <TextBlock x:Name="TierBasisHint" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{StaticResource WarningSoft}" CornerRadius="6"
                                        Padding="12,9" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Foreground="{StaticResource Warning}"
                                               Text="Schimbarea bazei de calcul schimbă înțelesul pragurilor definite pe niveluri. După ce o modifici, verifică pragurile din fila Niveluri — un prag de 1.000 înseamnă altceva în lei decât în puncte." />
                                </Border>

                                <StackPanel Margin="0,14,0,0" MaxWidth="400" HorizontalAlignment="Left">
                                    <TextBlock Text="PERIOADA DE CALIFICARE PENTRU NIVEL (LUNI)"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="QualifyingBox" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Rulajul se numără pe această fereastră mobilă. Zero înseamnă că se ia tot istoricul, iar nivelul nu mai scade niciodată." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Identitatea programului" Style="{StaticResource H2}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="NUMELE MAGAZINULUI" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="StoreNameBox" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="NUMELE PROGRAMULUI" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ProgramNameBox" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,24">
                            <Button Content="Salvează regulile" MinWidth="170" Click="OnSaveRules" />
                            <Button Content="Renunță la modificări" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="OnReloadRules" />
                            <TextBlock x:Name="RulesStatus" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================= Niveluri ==== -->
            <TabItem Header="Niveluri">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Nivelul unui client se stabilește după rulajul din perioada de calificare. Modificarea pragurilor se aplică imediat tuturor clienților, la următoarea recalculare." />

                    <DataGrid x:Name="TiersGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Nivel" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}">
                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                                       FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Prag rulaj (lei)" Width="150"
                                                Binding="{Binding Threshold, StringFormat='N2'}" />
                            <DataGridTextColumn Header="Multiplicator puncte" Width="160"
                                                Binding="{Binding EarnMultiplier, StringFormat='0.##'}" />
                            <DataGridTextColumn Header="Reducere permanentă (%)" Width="190"
                                                Binding="{Binding StandingDiscountPercent, StringFormat='0.##'}" />
                            <DataGridTextColumn Header="Beneficii" Width="*" Binding="{Binding Benefits}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Nivel nou" Margin="0,0,8,0" Click="OnNewTier" />
                        <Button Content="Modifică" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Click="OnEditTier" />
                        <Button Content="Șterge" Style="{StaticResource SecondaryButton}" Click="OnDeleteTier" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ======================================== Recompense ==== -->
            <TabItem Header="Recompense">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Catalogul din care clienții își aleg beneficiile. Recompensele deja acordate păstrează o copie a datelor, deci modificarea sau ștergerea nu afectează istoricul." />

                    <DataGrid x:Name="RewardsGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Denumire" Width="2*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Puncte" Width="90" Binding="{Binding PointsCost}" />
                            <DataGridTextColumn Header="Beneficiu" Width="180" Binding="{Binding ValueLabel}" />
                            <DataGridTextColumn Header="Bon minim (lei)" Width="140"
                                                Binding="{Binding MinPurchaseAmount, StringFormat='N2'}" />
                            <DataGridTemplateColumn Header="Stare" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                                    <Setter Property="Text" Value="Inactivă" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Activă" />
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource Success}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Descriere" Width="*" Binding="{Binding Description}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Recompensă nouă" Margin="0,0,8,0" Click="OnNewReward" />
                        <Button Content="Modifică" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Click="OnEditReward" />
                        <Button Content="Șterge" Style="{StaticResource SecondaryButton}" Click="OnDeleteReward" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ========================================== Campanii ==== -->
            <TabItem Header="Campanii">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Perioade în care punctele se acordă înmulțit: puncte duble într-un weekend, bonus de sezon, mai multe puncte în fiecare zi de marți. Campania se aplică peste bonusul de nivel al clientului." />

                    <DataGrid x:Name="CampaignsGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Denumire" Width="2*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Perioadă" Width="190" Binding="{Binding PeriodLabel}" />
                            <DataGridTextColumn Header="Multiplicator" Width="120" Binding="{Binding MultiplierLabel}" />
                            <DataGridTextColumn Header="Zile" Width="180" Binding="{Binding DaysLabel}" />
                            <DataGridTemplateColumn Header="Stare" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                                    <Setter Property="Text" Value="Inactivă" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Activă" />
                                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Campanie nouă" Margin="0,0,8,0" Click="OnNewCampaign" />
                        <Button Content="Modifică" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Click="OnEditCampaign" />
                        <Button Content="Șterge" Style="{StaticResource SecondaryButton}" Click="OnDeleteCampaign" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ==================================== Câmpuri pe client ==== -->
            <TabItem Header="Câmpuri client">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Informațiile în plus pe care le reține magazinul despre fiecare client: mărime, stil preferat, oraș, cum a aflat de program. Apar în fișa clientului și, dacă vrei, în căutarea de la casă." />

                    <DataGrid x:Name="FieldsGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Etichetă" Width="2*" Binding="{Binding Label}" />
                            <DataGridTextColumn Header="Nume scurt" Width="160" Binding="{Binding Key}" />
                            <DataGridTextColumn Header="Tip" Width="140" Binding="{Binding KindLabel}" />
                            <DataGridCheckBoxColumn Header="Obligatoriu" Width="100" Binding="{Binding IsRequired}" />
                            <DataGridCheckBoxColumn Header="Căutabil" Width="90" Binding="{Binding IncludeInSearch}" />
                            <DataGridCheckBoxColumn Header="În listă" Width="90" Binding="{Binding ShowInList}" />
                            <DataGridCheckBoxColumn Header="Activ" Width="*" Binding="{Binding IsActive}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Câmp nou" Margin="0,0,8,0" Click="OnNewField" />
                        <Button Content="Modifică" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Click="OnEditField" />
                        <Button Content="Șterge" Style="{StaticResource SecondaryButton}" Click="OnDeleteField" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ========================================= Identitate ==== -->
            <TabItem Header="Identitate" x:Name="BrandingTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Culoarea programului" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Culoarea butoanelor principale și a evidențierilor. Se aplică imediat, în tot programul." />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CULOARE (#RRGGBB)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="AccentBox" TextChanged="OnAccentChanged" />
                                    </StackPanel>

                                    <Border x:Name="AccentPreview" Grid.Column="1" Width="52" Margin="10,18,0,0"
                                            CornerRadius="6" BorderBrush="{StaticResource Border}" BorderThickness="1" />

                                    <WrapPanel x:Name="PalettePanel" Grid.Column="2" Margin="16,18,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Logo" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Apare în bara laterală și pe ecranul de autentificare. Imaginea se păstrează în baza de date, deci intră automat în copiile de siguranță." />

                                <Border Background="{StaticResource SidebarBg}" CornerRadius="8"
                                        Padding="16" Margin="0,12,0,0" HorizontalAlignment="Left">
                                    <Grid MinWidth="200" MinHeight="48">
                                        <TextBlock x:Name="NoLogoText" Text="Niciun logo încărcat"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource SidebarMuted}" FontSize="12" />
                                        <Image x:Name="LogoPreview" MaxHeight="64" MaxWidth="220"
                                               Stretch="Uniform" Visibility="Collapsed" />
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Alege imaginea" Click="OnPickLogo" />
                                    <Button Content="Scoate logo-ul" Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0" Click="OnRemoveLogo" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,24">
                            <StackPanel>
                                <TextBlock Text="Formatul codului de card" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Se aplică doar codurilor generate de acum înainte. Cardurile deja emise rămân neschimbate." />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="PREFIX" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="CardPrefixBox" TextChanged="OnCardFormatChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="NUMĂR DE CIFRE" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="CardDigitsBox" TextChanged="OnCardFormatChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="CUM VA ARĂTA" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="CardSampleText" Style="{StaticResource H3}"
                                                   VerticalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Content="Salvează identitatea" MinWidth="180" Click="OnSaveBranding" />
                                    <TextBlock x:Name="BrandingStatus" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="16,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================= Utilizatori ==== -->
            <TabItem Header="Utilizatori" x:Name="UsersTab">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Fiecare persoană care lucrează la casă are propriul cont. Astfel se poate ști cine a acordat o recompensă sau a corectat un sold." />

                    <DataGrid x:Name="UsersGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nume" Width="2*" Binding="{Binding Username}" />
                            <DataGridTextColumn Header="Rol" Width="150" Binding="{Binding RoleLabel}" />
                            <DataGridTemplateColumn Header="Stare" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                                    <Setter Property="Text" Value="Dezactivat" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Activ" />
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource Success}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ultima autentificare" Width="*"
                                                Binding="{Binding LastLoginAt, StringFormat='dd.MM.yyyy HH:mm'}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Cont nou" Margin="0,0,8,0" Click="OnNewUser" />
                        <Button Content="Modifică" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Click="OnEditUser" />
                        <Button Content="Resetează parola" Style="{StaticResource SecondaryButton}"
                                Click="OnResetPassword" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================================ Sistem ==== -->
            <TabItem Header="Sistem" x:Name="SystemTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Baza de date" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Toate datele magazinului stau într-un singur fișier. Copierea lui înseamnă o copie de siguranță completă." />

                                <TextBlock Text="LOCAȚIE" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                                <TextBox x:Name="DatabasePathBox" IsReadOnly="True" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Salvează o copie de siguranță" Click="OnBackup" />
                                    <Button Content="Deschide folderul" Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0" Click="OnOpenFolder" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Întreținere" Style="{StaticResource H2}" />

                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="Verificarea punctelor expirate rulează automat la fiecare pornire. Poate fi pornită și manual, dacă programul rămâne deschis mai multe zile." />

                                <Button Content="Verifică punctele expirate acum" HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"
                                        Click="OnRunExpiry" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Date demonstrative" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="Generează clienți și istoric inventat, pentru a vedea cum arată programul înainte de a avea clienți reali. Funcționează doar pe o bază de date goală." />

                                <Button Content="Generează 60 de clienți demonstrativi" HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"
                                        Click="OnGenerateDemo" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Import de clienți" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="Aduce clienții dintr-un fișier CSV — dintr-un Excel, dintr-un program vechi sau de la un alt magazin. Înainte de a scrie ceva, programul îți arată exact ce ar intra și ce ar fi ignorat." />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Importă clienți din CSV" Click="OnImportCustomers" />
                                    <Button Content="Salvează fișierul model" Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0" Click="OnDownloadTemplate" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Export de date" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="Scoate datele în CSV, gata de deschis în Excel. Fișierele folosesc punct și virgulă ca separator, forma pe care Excel-ul cu setări românești o citește corect." />

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Clienți" Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,8" Click="OnExportCustomers" />
                                    <Button Content="Cumpărături" Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,8" Click="OnExportPurchases" />
                                    <Button Content="Istoricul punctelor" Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,8" Click="OnExportLedger" />
                                </WrapPanel>

                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="Exporturile de cumpărături și de puncte acoperă ultimele 12 luni." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,24">
                            <StackPanel>
                                <TextBlock Text="Despre program" Style="{StaticResource H2}" />
                                <TextBlock x:Name="AboutText" Style="{StaticResource Caption}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
