<Window x:Class="Fidelizare.App.Views.CampaignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campanie"
        Width="520" MinHeight="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="O perioadă în care punctele se acordă înmulțit. Se aplică peste bonusul de nivel al clientului." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <StackPanel>

                <TextBlock Text="DENUMIRE *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" />

                <TextBlock Text="DESCRIERE" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                <TextBox x:Name="DescriptionBox" Height="52" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DE LA DATA *" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="FromPicker" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PÂNĂ LA DATA *" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="ToPicker" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="Ambele zile sunt incluse în campanie." />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MULTIPLICATOR *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MultiplierBox" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="2 înseamnă puncte duble, 1,5 înseamnă cu 50% mai multe." />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="VALOAREA MINIMĂ A BONULUI" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MinPurchaseBox" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Zero înseamnă că se aplică oricărui bon." />
                    </StackPanel>
                </Grid>

                <TextBlock Text="ZILELE SĂPTĂMÂNII" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <StackPanel>
                        <CheckBox x:Name="AllDaysCheck" Content="În toate zilele" IsChecked="True"
                                  Click="OnAllDaysChanged" FontWeight="SemiBold" />

                        <WrapPanel x:Name="DaysPanel" Margin="0,8,0,0" IsEnabled="False">
                            <CheckBox x:Name="MondayCheck" Content="Luni" Margin="0,0,14,6" />
                            <CheckBox x:Name="TuesdayCheck" Content="Marți" Margin="0,0,14,6" />
                            <CheckBox x:Name="WednesdayCheck" Content="Miercuri" Margin="0,0,14,6" />
                            <CheckBox x:Name="ThursdayCheck" Content="Joi" Margin="0,0,14,6" />
                            <CheckBox x:Name="FridayCheck" Content="Vineri" Margin="0,0,14,6" />
                            <CheckBox x:Name="SaturdayCheck" Content="Sâmbătă" Margin="0,0,14,6" />
                            <CheckBox x:Name="SundayCheck" Content="Duminică" Margin="0,0,14,6" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Util pentru campanii de tipul „puncte duble marțea”, care se repetă în fiecare săptămână a perioadei." />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="ActiveCheck" Content="Campanie activă" IsChecked="True" Margin="0,16,0,0" />

                <Border x:Name="ErrorBanner" Background="{StaticResource DangerSoft}"
                        CornerRadius="6" Padding="10,7" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Renunță" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                    IsCancel="True" Click="OnCancel" />
            <Button Content="Salvează" IsDefault="True" Click="OnSave" MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
