<Window x:Class="Fidelizare.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurare inițială"
        Width="560" MinHeight="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="34,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="StepText" Style="{StaticResource Caption}"
                       Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
            <TextBlock x:Name="TitleText" Text="Bine ai venit" Style="{StaticResource H1}" Margin="0,4,0,0" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">

            <!-- ============================ Pasul 1: magazin și administrator ==== -->
            <ScrollViewer x:Name="Step1Panel" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="NUMELE MAGAZINULUI" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="StoreNameBox" Text="Magazinul meu" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="NUMELE PROGRAMULUI" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ProgramNameBox" Text="Club Fidelitate" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Banner}" Margin="0,18,0,0">
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Contul de administrator schimbă regulile, corectează puncte și creează celelalte conturi. Nu este contul cu care se lucrează zilnic la casă — acelea le creezi la pasul următor." />
                    </Border>

                    <TextBlock Text="NUMELE TĂU" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
                    <TextBox x:Name="NameBox" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Cu acest nume te autentifici și tot el apare în rapoarte. Ex: Cristian Popescu." />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PAROLĂ" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="PasswordBox" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CONFIRMĂ PAROLA" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="ConfirmBox" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Minimum 8 caractere, cu cel puțin o literă și o cifră. Nu există cale de recuperare din afara programului — păstreaz-o în siguranță." />
                </StackPanel>
            </ScrollViewer>

            <!-- ================================ Pasul 2: conturi de lucru ==== -->
            <ScrollViewer x:Name="Step2Panel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>

                    <Border Style="{StaticResource Banner}">
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Fiecare persoană care lucrează la casă are nevoie de contul ei. Programul reține cine a înregistrat fiecare vânzare și cine a acordat fiecare recompensă — cu un cont comun, informația nu valorează nimic." />
                    </Border>

                    <TextBlock Text="NUMELE ANGAJATULUI" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
                    <TextBox x:Name="StaffNameBox" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Cu el se autentifică și tot el apare în jurnal. Ex: Ana Popescu." />

                    <TextBlock Text="ROL" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                    <ComboBox x:Name="StaffRoleBox" SelectionChanged="OnStaffRoleChanged">
                        <ComboBoxItem Content="Casier" IsSelected="True" />
                        <ComboBoxItem Content="Responsabil" />
                    </ComboBox>
                    <TextBlock x:Name="RoleHintText" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               TextWrapping="Wrap" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PAROLĂ" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="StaffPasswordBox" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CONFIRMĂ PAROLA" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="StaffConfirmBox" />
                        </StackPanel>
                    </Grid>

                    <Button Content="Adaugă contul" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnAddStaff" />

                    <Border x:Name="StaffListCard" Style="{StaticResource CardTight}" Margin="0,18,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="CONTURI CREATE" Style="{StaticResource FieldLabel}" />
                            <ItemsControl x:Name="StaffList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="0,3,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" TextWrapping="Wrap"
                               Text="Poți adăuga oricâte conturi. Le poți crea și mai târziu, oricând, din Administrare → Utilizatori." />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2">
            <Border x:Name="ErrorBanner" Background="{StaticResource DangerSoft}"
                    CornerRadius="6" Padding="12,9" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="Renunță" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" IsCancel="True" Click="OnCancel" />
                <Button x:Name="NextButton" Content="Continuă" IsDefault="True"
                        Click="OnNext" MinWidth="180" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
