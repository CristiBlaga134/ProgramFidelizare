<Window x:Class="Fidelizare.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autentificare"
        Width="420" MinHeight="340"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Margin="30" Padding="30" VerticalAlignment="Center">
            <StackPanel>

                <Image x:Name="LogoImage" MaxHeight="72" MaxWidth="240" Stretch="Uniform"
                       Margin="0,0,0,16" Visibility="Collapsed" />
                <TextBlock x:Name="ProgramNameText" Text="Club Fidelitate"
                           Style="{StaticResource H1}" HorizontalAlignment="Center" />
                <TextBlock x:Name="StoreNameText" Text="Magazinul meu"
                           Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />

                <Separator Margin="0,22" />

                <TextBlock Text="NUME DE UTILIZATOR" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="UsernameBox" />

                <TextBlock Text="PAROLĂ" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                <PasswordBox x:Name="PasswordBox" />

                <Border x:Name="ErrorBanner" Background="{StaticResource DangerSoft}"
                        CornerRadius="6" Padding="12,9" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                </Border>

                <Button Content="Intră în program" Style="{StaticResource BigButton}"
                        Margin="0,22,0,0" IsDefault="True" Click="OnLogin" />

                <Button Content="Închide programul" Style="{StaticResource GhostButton}"
                        Margin="0,10,0,0" HorizontalAlignment="Center" IsCancel="True" Click="OnCancel" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
