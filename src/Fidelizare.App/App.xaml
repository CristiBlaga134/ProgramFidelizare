<Application x:Class="Fidelizare.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fidelizare.App.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:TextToVisibilityConverter x:Key="TextToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:MoneyConverter x:Key="Money" />
            <conv:SignedPointsConverter x:Key="SignedPoints" />
            <conv:PointsBrushConverter x:Key="PointsBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
